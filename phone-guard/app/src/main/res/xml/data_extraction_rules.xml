<?xml version="1.0" encoding="utf-8"?>
<!-- 비밀 금고(EncryptedSharedPreferences)가 백업으로 빠져나가지 않도록 백업을 비운다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
