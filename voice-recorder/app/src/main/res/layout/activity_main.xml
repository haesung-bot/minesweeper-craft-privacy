<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/app_name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 상태 카드 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_off"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.soundcatch.recorder.LevelMeterView
                android:id="@+id/meter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/levelText"
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/warningText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/warning"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/toggleButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:text="@string/start"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/uploadText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/uploadNowButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_now" />
        </LinearLayout>

        <!-- 구글 드라이브 -->
        <TextView
            style="@style/Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_drive" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drive_help" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/urlEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/url_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="3"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/pasteButton"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paste" />
            </LinearLayout>

            <EditText
                android:id="@+id/secretEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/secret_hint"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword"
                android:maxLines="1"
                android:textSize="14sp" />

            <Button
                android:id="@+id/testButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/test" />

            <TextView
                android:id="@+id/testText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 소리 감지 -->
        <TextView
            style="@style/Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_detect" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sensLabel"
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <SeekBar
                android:id="@+id/sensSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="9" />

            <TextView
                android:id="@+id/silenceLabel"
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <SeekBar
                android:id="@+id/silenceSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="58" />

            <TextView
                android:id="@+id/preRollLabel"
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <SeekBar
                android:id="@+id/preRollSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="5" />

            <TextView
                android:id="@+id/maxLabel"
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <SeekBar
                android:id="@+id/maxSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="29" />
        </LinearLayout>

        <!-- 기타 -->
        <TextView
            style="@style/Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_etc" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/wifiCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wifi_only" />

            <CheckBox
                android:id="@+id/deleteCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete_after" />

            <CheckBox
                android:id="@+id/autoStartCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_start" />

            <Button
                android:id="@+id/batteryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/battery" />

            <TextView
                android:id="@+id/batteryText"
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/footer" />
    </LinearLayout>
</ScrollView>
